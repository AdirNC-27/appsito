rules_version = '2';

// Cada usuario solo puede leer y escribir SUS propios datos (users/{su uid}/...).
// Copia este texto en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
